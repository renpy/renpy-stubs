import io as io
from _frozen_importlib import BuiltinImporter as BuiltinImporter
from _io import FileIO as FileIO
from builtins import bytes as bytes
from builtins import str
from typing import Any

class RWopsIO(io.RawIOBase):
    def __init__(
        self,
        filelike: io.IOBase | bytes,
        mode: str = "rb",
        base: int | None = None,
        length: int | None = None,
        name: str | None = None,
    ) -> None: ...
    def fileno(self) -> int: ...
    @staticmethod
    def from_buffer(buffer: bytes, mode: str = "rb", name: str | None = None) -> None: ...
    @staticmethod
    def from_split(a: bytes, b: bytes, name: str | None = None) -> None: ...
    def readable(self) -> bool: ...
    def seekable(self) -> bool: ...
    def truncate(self, size: int | None = None) -> int: ...
    def writable(self) -> bool: ...

class RWopsIOImpl:
    name: str | None
    base: int | None
    length: int | None
    def __init__(
        self,
        filelike: io.IOBase | bytes,
        mode: str = "rb",
        base: int | None = None,
        length: int | None = None,
        name: str | None = None,
    ) -> None: ...
    def __reduce__(self) -> tuple[Any, ...]: ...
    def close(self) -> None: ...
    def is_closed(self) -> bool: ...
    def readinto(self, b: bytearray) -> int: ...
    def seek(self, offset: int, whence: int = 0) -> int: ...
    def tell(self) -> int: ...
    def write(self, b: bytes) -> int: ...
