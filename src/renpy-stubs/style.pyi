class PropertyFunctionWrapper:
    def __reduce__(self) -> str | tuple[Any, ...]: ...

Style = renpy.styledata.styleclass.Style
if TYPE_CHECKING:
    type StyleLike = StyleCore | str | tuple[str, ...] | None
    type StyleBackup = dict[tuple[str, ...], tuple[tuple[str, ...] | None, list[dict[str, Any]]]]

class StyleCore:
    prefix: str
    properties: list[dict[str, Any]] = []
    parent: tuple[str, ...] | None
    name: tuple[str, ...] | None
    help: str | None

    def __init__(
        self,
        parent: StyleLike,
        properties: dict[str, Any] | None = None,
        name: tuple[str, ...] | None = None,
        help: str | None = None,
        heavy: bool = True,
    ) -> None: ...
    def __delattr__(self, name: str) -> None: ...
    def __eq__(self, value: object) -> bool: ...
    def __ge__(self, value: object) -> bool: ...
    def __getitem__(self, key: tuple[str, ...]) -> StyleCore: ...
    def __gt__(self, value: object) -> bool: ...
    def __le__(self, value: object) -> bool: ...
    def __lt__(self, value: object) -> bool: ...
    def __ne__(self, value: object) -> bool: ...
    def __setattr__(self, name: str, value: Any) -> None: ...
    def add_properties(self, properties: dict[str, Any]) -> None: ...
    def clear(self) -> None: ...
    def copy(self) -> Self: ...
    def delattr(self, property: str) -> None: ...
    def get_offset(self) -> int: ...
    def get_placement(
        self,
    ) -> Placement: ...
    def inspect(self) -> list[tuple[tuple[str, ...] | None, dict[str, Any]]]: ...
    def set_parent(self, parent: StyleLike) -> None: ...
    def set_prefix(self, prefix: str) -> None: ...
    def setattr(self, property: str, value: Any) -> None: ...
    def setdefault(self, **properties: Any) -> None: ...
    def take(self, other: str | StyleCore) -> None: ...

class StyleManager:
    def __init__(self) -> None: ...
    def __getattr__(self, name: str) -> StyleCore: ...
    def __getitem__(self, name: str) -> StyleCore: ...
    def __setattr__(self, name: str, value: StyleCore) -> None: ...
    def __setitem__(self, name: str, value: StyleCore) -> None: ...
    def create(self, name: tuple[str, ...], parent: StyleLike, description: str | None = None) -> None: ...
    def exists(self, name: str | tuple[str, ...]) -> bool: ...
    def get(self, name: str | tuple[str, ...]) -> None: ...
    def rebuild(self) -> None: ...

def backup() -> StyleBackup: ...
