class Persistent:
    _preferences: renpy.preferences.Preferences
    _seen_ever: dict[renpy.ast.NodeName | int, bool]
    _seen_images: dict[tuple[str, ...], bool]
    _chosen: dict[tuple[renpy.ast.NodeName, str], bool]
    _seen_audio: dict[str, bool]
    _seen_translates: set[str | int]
    def __init__(self) -> None: ...
    def __getattr__(self, attr: str) -> None: ...

def safe_deepcopy[T](o: T, reduction_name: str) -> T: ...

backup: dict[str, Any]

def find_changes() -> bool: ...
def load(filename: str) -> Persistent | None: ...
def init() -> Persistent: ...
def init_debug_pickler() -> None: ...

registry: dict[str, Callable[[Any, Any, Any], Any]]

def register_persistent[T](field: str, func: Callable[[Any, Any, Any], Any]) -> None: ...
def default_merge(old: Any, new: Any, current: Any) -> Any: ...
def dictset_merge[KT, T](old: dict[KT, T], new: dict[KT, T], current: dict[KT, T]) -> dict[KT, T]: ...
def merge(other: Persistent) -> None: ...

persistent_mtime: float

def check_update() -> None: ...
def update(force_save: bool = False) -> None: ...

should_save_persistent: bool

def save() -> None: ...

MP_instances: weakref.WeakSet[_MultiPersistent]

def save_MP() -> None: ...
def save_on_quit_MP() -> None: ...
def get_MP(name: str) -> _MultiPersistent | None: ...

class _MultiPersistent:
    _save_on_quit: bool
    _name: str
    _filename: str
    def __getattr__(self, name: str) -> None: ...
    def save(self) -> None: ...

def MultiPersistent(name: str, save_on_quit: bool = False) -> _MultiPersistent: ...
