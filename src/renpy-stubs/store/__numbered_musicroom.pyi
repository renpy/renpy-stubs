    identity_fields: Sequence[str]
    equality_fields: Sequence[str]
    mr: MusicRoom
    filename: str
    selected: bool
    def __init__(self, mr: MusicRoom, filename: str) -> None: ...
    def __call__(self) -> None: ...
    def get_sensitive(self) -> bool: ...
    def get_selected(self) -> bool: ...
